const carrusel = document.querySelector(".ofertas-carrusel");

let isPaused = false;
carrusel.addEventListener("click", () => {
  if (!isPaused) {
    // Detener el movimiento
    carrusel.style.animationPlayState = "paused";
    isPaused = true;
  } else {
    // Reanudar el movimiento
    carrusel.style.animationPlayState = "running";
    isPaused = false;
  }
});

// Mostrar trabajadores por oficio
function mostrarTrabajadoresPorOficio(oficio) {
  const lista = trabajadores.filter(t => t.oficio === oficio);
  const resultadoOficio = document.getElementById("resultado-oficio");
  resultadoOficio.innerHTML = `
    <h2>Trabajadores en el oficio de ${oficio}</h2>
    <div class="lista-trabajadores">
      ${lista.map(t => `
        <div class="trabajador">
          <img src="imagenes/${t.imagen}" alt="${t.nombre}">
          <p><strong>${t.nombre}</strong></p>
          <p>Edad: ${t.edad}</p>
          <p>Antigüedad: ${t.antiguedad} años</p>
          <p>Localidad: ${t.localidad}</p>
        </div>
      `).join("")}
    </div>
  `;
}

// Cargar la lista de oficios en el menú lateral
function cargarOficios() {
  const listaOficios = document.getElementById("lista-oficios");
  oficios.forEach(oficio => {
    const li = document.createElement("li");
    li.textContent = oficio;
    li.addEventListener("click", () => mostrarTrabajadoresPorOficio(oficio));
    listaOficios.appendChild(li);
  });
}

cargarOficios();

// Mostrar el formulario para agregar trabajadores
function mostrarFormulario() {
  document.getElementById("trabaja").style.display = "block";
}

// Agregar un nuevo trabajador
document.getElementById("formulario").addEventListener("submit", function(e) {
  e.preventDefault();

  const nombre = document.getElementById("nombre").value;
  const edad = document.getElementById("edad").value;
  const localidad = document.getElementById("localidad").value;
  const oficio = document.getElementById("oficio").value;
  const antiguedad = document.getElementById("antiguedad").value;
  const imagenInput = document.getElementById("imagen").files[0];

  const reader = new FileReader();
  reader.onload = function() {
    const imagen = reader.result;

    trabajadores.push({ nombre, edad, localidad, oficio, antiguedad, imagen: imagen });
    localStorage.setItem("trabajadores", JSON.stringify(trabajadores));
    alert("¡Trabajador agregado!");
  };

  if (imagenInput) {
    reader.readAsDataURL(imagenInput);
  }
});

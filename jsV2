// Función para generar las ofertas y cargarlas en el carrusel
function cargarOfertasRelampago() {
  const contenedor = document.getElementById("ofertas-relampago");
  const ofertas = trabajadores.slice(0, 5); // Limitar a 5 ofertas

  // Crear el contenedor del carrusel
  const carrusel = document.createElement('div');
  carrusel.classList.add('ofertas-carrusel');
  
  // Generar las ofertas
  ofertas.forEach(trabajador => {
    const oferta = document.createElement('div');
    oferta.classList.add('oferta');
    oferta.innerHTML = `
      <img src="imagenes/${trabajador.imagen}" alt="${trabajador.nombre}">
      <h4>${trabajador.oficio}</h4>
      <p>${trabajador.nombre}</p>
      <p>${trabajador.localidad}</p>
    `;
    carrusel.appendChild(oferta);
  });

  // Añadir el carrusel al contenedor de ofertas
  contenedor.innerHTML = ''; // Limpiar el contenedor antes de agregar
  contenedor.appendChild(carrusel);
}

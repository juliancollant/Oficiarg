document.addEventListener('DOMContentLoaded', function() {
  cargarOficios();
  cargarOfertas();
  iniciarCarrusel();
  manejarMenu();
});

function cargarOficios() {
  const oficios = [
    { nombre: 'Carpintero', trabajadores: 2 },
    { nombre: 'Electricista', trabajadores: 3 },
    { nombre: 'Gasista', trabajadores: 2 },
    { nombre: 'Jardinero', trabajadores: 5 },
    { nombre: 'Mecánico', trabajadores: 4 }
  ];

  const listaOficios = document.getElementById('lista-oficios');
  oficios.forEach(oficio => {
    const li = document.createElement('li');
    li.textContent = `${oficio.nombre} (${oficio.trabajadores} trabajadores)`;
    listaOficios.appendChild(li);
  });
}

function cargarOfertas() {
  const ofertas = [
    { imagen: 'imagenes/trabajador1.jpg', oficio: 'Carpintero', descuento: '10%' },
    { imagen: 'imagenes/trabajador2.jpg', oficio: 'Electricista', descuento: '15%' },
    { imagen: 'imagenes/trabajador3.jpg', oficio: 'Gasista', descuento: '5%' },
    { imagen: 'imagenes/trabajador4.jpg', oficio: 'Jardinero', descuento: '20%' },
    { imagen: 'imagenes/trabajador5.jpg', oficio: 'Mecánico', descuento: '25%' }
  ];

  const ofertasRelampago = document.getElementById('ofertas-relampago');
  ofertas.forEach(oferta => {
    const div = document.createElement('div');
    div.classList.add('oferta');
    
    const img = document.createElement('img');
    img.src = oferta.imagen;
    img.alt = oferta.oficio;
    
    const texto = document.createElement('p');
    texto.textContent = `${oferta.oficio} - ${oferta.descuento}`;
    
    div.appendChild(img);
    div.appendChild(texto);
    ofertasRelampago.appendChild(div);
  });
}

function iniciarCarrusel() {
  let idx = 0;
  const imgs = document.querySelectorAll('.banner-img');
  setInterval(() => {
    imgs[idx].classList.remove('active');
    idx = (idx + 1) % imgs.length;
    imgs[idx].classList.add('active');
  }, 3000); // Cambiar cada 3 segundos
}

function manejarMenu() {
  const dropdown = document.querySelectorAll('.dropdown');
  dropdown.forEach((item) => {
    item.addEventListener('click', function() {
      this.classList.toggle('active');
    });
  });
}


<!DOCTYPE html>
<html lang="es">
<head>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;700&display=swap" rel="stylesheet">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>OFICIARG</title>
  <link rel="icon" href="imagenes/ico.ico">
  <link rel="stylesheet" href="estilo.css">
</head>
<body>

  <!-- Menú Lateral -->
  <aside class="menu-lateral">
    <h1 class="titulo-sitio">🇦🇷 OFICIARG</h1>
    <nav>
      <ul>
        <li><a href="#inicio">Inicio</a></li>
        <li class="dropdown">
          <a href="#">Oficios</a>
          <ul id="lista-oficios"></ul>
        </li>
        <li class="dropdown">
          <a href="#">Localidades</a>
          <ul>
            <li>Resistencia</li>
            <li>Fontana</li>
            <li>Barranqueras</li>
            <li>Vilelas</li>
            <li>Puerto Tirol</li>
          </ul>
        </li>
        <li><a href="#sobre-nosotros">Sobre nosotros</a></li>
        <li><a href="#trabaja" onclick="mostrarFormulario()">Trabajá con nosotros</a></li>
      </ul>
    </nav>
  </aside>

  <!-- Contenido Principal -->
  <main>
    <section class="presentacion" id="inicio">
      <h2><span class="ofici">OFICI</span><span class="arg">ARG</span></h2>
      <p>Conectamos a quienes necesitan trabajar con profesionales capacitados. Tu oficio, tu oportunidad. ¡Hacelo crecer con nosotros!</p>
      <a href="#sobre-nosotros" class="boton-vermas">Conocé más sobre nosotros</a>
    </section>

    <!-- Banner -->
    <section class="banner-container">
  <img src="imagenes/sol.png" alt="sol" class="sol sol-izquierda"> <!-- Sol izquierdo -->
  <div class="banner">
    <img src="imagenes/baner1.jpg" class="banner-img active" alt="Banner 1">
    <img src="imagenes/baner2.jpg" class="banner-img" alt="Banner 2">
    <img src="imagenes/baner3.jpg" class="banner-img" alt="Banner 3">
  </div>
  <img src="imagenes/sol.png" alt="sol" class="sol sol-derecha"> <!-- Sol derecho -->
</section>
    <!-- Ofertas Relámpago -->
    <h2 class="titulo-ofertas">⚡ Ofertas Relámpago</h2>
    <section class="ofertas-relampago" id="ofertas-relampago"></section>

    <!-- Formulario para trabajar con nosotros -->
    <section id="trabaja" class="formulario-trabajo" style="display:none;">
      <h3>Sumate a OFICIARG</h3>
      <form id="formulario">
        <input type="text" placeholder="Nombre" id="nombre" required>
        <input type="number" placeholder="Edad" id="edad" required>
        <input type="text" placeholder="Localidad" id="localidad" required>
        <input type="text" placeholder="Oficio" id="oficio" required>
        <input type="number" placeholder="Antigüedad (años)" id="antiguedad" required>
        <input type="file" id="imagen" accept="image/*">
        <button type="submit">Agregar</button>
      </form>
    </section>

    <!-- Información sobre nosotros -->
    <section id="sobre-nosotros" class="sobre-nosotros">
      <div class="caja-info">
        <h2>Nuestra visión</h2>
        En OFICIARG, creemos en el poder del trabajo argentino como motor de cambio y crecimiento. Nuestra misión es conectar a los mejores profesionales de oficios con quienes los necesitan, fomentando una economía local más sólida y dinámica. Buscamos ofrecer soluciones rápidas, confiables y de calidad, garantizando un servicio excelente en cada rincón de la Argentina.<br><br>
          Queremos ser el puente entre quienes brindan sus habilidades con dedicación y quienes buscan un trabajo bien hecho. Nos importa que cada cliente sienta no solo satisfacción, sino también el orgullo de apoyar el desarrollo de nuestra comunidad y economía.<br><br>
          En OFICIARG, creemos en una Argentina más conectada, solidaria y trabajadora, donde cada oficio y cada profesional aporta a un futuro mejor para todos.
      </div>
    </section>
  </main>

  <script src="script.js"></script>
</body>
</html>
